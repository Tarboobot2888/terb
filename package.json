{
  "name": "bot-terboo",
  "version": "6.0.0",
  "description": "Bot Terboo V6 — AI-first WhatsApp Multi-Device assistant with a companion website and Telegram VPS bot: one AI kernel, real image/voice/video/document understanding, background tasks, cloud (Virtualizor · Pterodactyl), 900+ plugins and a trilingual interface (Arabic / English / Spanish).",
  "main": "index.js",
  "scripts": {
    "start": "NODE_ENV=production node index.js",
    "dev": "NODE_ENV=development node index.js",
    "test": "npm run test:local && npm run audit:strict && npm run lint",
    "test:syntax": "node tests/terboo-syntax.test.mjs && node tests/terboo-import-graph.test.mjs",
    "test:local": "node tools/terboo-run-tests.mjs",
    "test:live": "node tests/ai-provider-smoke.test.mjs && node tests/local-image-enhancement.test.mjs && node tests/terboo-code-review.live.test.mjs && node tools/terboo-scraper-live.mjs",
    "lint": "eslint plugins/ src/ case/ tools/ tests/ index.js config.js",
    "audit": "node tools/terboo-audit.mjs",
    "audit:report": "node tools/terboo-audit.mjs --report",
    "manifest": "node tools/terboo-manifest.mjs --out manifest.json",
    "benchmark": "node tools/terboo-benchmark.mjs",
    "benchmark:compare": "node tools/terboo-benchmark-compare.mjs",
    "brand:assets": "node tools/terboo-brand-assets.mjs",
    "audit:strict": "node tools/terboo-audit.mjs --strict",
    "ui:matrix": "node tools/terboo-command-ui-matrix.mjs"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "multi-device",
    "plugin"
  ],
  "author": "Terboo",
  "license": "ISC",
